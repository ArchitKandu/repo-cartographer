# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — never commit real keys.

# One model provider is required; configure either or both. With both set,
# LLM_PROVIDER decides. With one, it is used automatically.
#
#   google      Gemini via Google AI Studio. 500 requests/day on the default
#               gemini-3.5-flash-lite — enough to iterate. Use this by default.
#   openrouter  Free open-weight models, nemotron-3-super-120b-a12b by default.
#               Stronger, but 50 requests/day total (~3 mapping runs).
# LLM_PROVIDER=google

# Get one at https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=AIza...

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Required by the GitHub tools and the test suite.
# Create at https://github.com/settings/tokens — read-only access to public
# repositories is enough. Without a token the GitHub API allows only 60
# requests/hour (5000 with one) and rejects code search outright.
GITHUB_TOKEN=ghp_...

# Optional per-provider model overrides. See repo_cartographer/models.py for the
# candidates worth trying and what each one trades away.
#
# Careful with Gemini: the capable Flash models allow only 20 requests/day each —
# one mapping run — while the Flash-Lite models allow 500.
# GOOGLE_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional tracing. Phase 4's definition of done is a trace showing each
# sub-agent in its own context window, and this is what turns it on: with these
# set, every run appears in LangSmith with the orchestrator, explorer and
# doc-writer as separate nested threads you can click into.
#
# Tracing is provider-independent — it records what the graph did, not who served
# the model — so it works the same on Gemini or OpenRouter and costs nothing
# against either quota. Free key at https://smith.langchain.com/settings.
#
# `scripts/show_contexts.py` reports the same split locally as numbers, and needs
# none of this. Set these when you want to read a transcript, not a total.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=repo-cartographer

# Requests per minute to allow the whole run — orchestrator and every sub-agent
# share one budget. Phase 4b dispatches explorers concurrently, and three agents
# in their own tool loops reach a free-tier ceiling in seconds; models.py rate
# limits to 80% of the tier's published limit so they queue instead of 429ing.
# Raise this on a paid tier — it is the one number that decides whether fan-out
# survives.
# REQUESTS_PER_MINUTE=15
