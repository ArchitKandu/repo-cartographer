# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches. Listed here rather than left to a global gitignore, so a fresh
# clone on someone else's machine stays clean too.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Environment variables
.env

# Agent scratch space: the workspace the filesystem backend writes notes into.
# Run output, not source — regenerated on every run.
tmp/
workspace/
