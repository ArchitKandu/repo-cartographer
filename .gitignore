# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches. Listed here rather than left to a global gitignore, so a fresh
# clone on someone else's machine stays clean too.
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Environment variables
.env
.env.local

# Agent scratch space: the workspace the filesystem backend writes notes into.
# Run output, not source — regenerated on every run. One directory per run
# since `workspaces.py`, so this grows until the prune job runs.
tmp/
backend/workspace/

# Recorded eval runs. Each file is a log of guides the agent produced for one
# case, written by scripts/run_evals.py and re-scored for free by --score-only.
# Machine-local by design: they are measurements of one machine's runs against
# one model, and committing them would invite reading a stale number as current.
backend/tests/evals/results/

.agents/
.claude/

# Node / Next.js (frontend)
node_modules/
.next/
out/
next-env.d.ts
