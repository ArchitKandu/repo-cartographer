# Copy to .env.local. Next.js reads that file automatically and it is gitignored.
#
# Two of these are NEXT_PUBLIC_, which means Next.js inlines them into the
# JavaScript it ships to the browser. That is correct for both — a publishable
# key is designed to be public, and Row Level Security is what decides what it can
# actually read (see backend/db/001_runs.sql).
#
# The key that must NEVER appear here is SUPABASE_SECRET_KEY. It bypasses RLS
# entirely. It belongs in backend/.env and nowhere else, and prefixing it with
# NEXT_PUBLIC_ would publish it to every visitor.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the Python API is listening. The backend's CORS_ORIGINS must in turn name
# this app's origin, or the browser will refuse the response it gets back.
NEXT_PUBLIC_API_URL=http://localhost:8000
